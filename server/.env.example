APP_NAME="FastAPI SaaS Boilerplate"
APP_VERSION="0.1.0"
APP_ENV="local"
APP_DEBUG="True"
APP_KEY="super-secret-key-change-in-production"
APP_HOST="localhost"
APP_PORT=8000

ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

DB_CONNECTION=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

LOG_LEVEL="INFO"

ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

MAIL_SERVER="localhost"
MAIL_PORT=587
MAIL_USERNAME="user"
MAIL_PASSWORD="password"
MAIL_FROM="support@example.com"